"""Launch a DX9 game and declare only the packed window reported by wiz3D."""
import argparse
import ctypes
import os
from pathlib import Path
import signal
import subprocess
import sys
import tempfile
import time


def descendants(root, known):
    parents = {}
    for entry in Path('/proc').iterdir():
        if entry.name.isdigit():
            try:
                text = (entry / 'stat').read_text()
                parents[int(entry.name)] = int(text[text.rfind(')') + 2:].split()[1])
            except (OSError, ValueError, IndexError):
                pass
    # Retain known Wine children after wineserver reparents them.
    known.intersection_update(parents)
    known.add(root)
    while True:
        added = {pid for pid, parent in parents.items() if parent in known} - known
        if not added:
            return known
        known.update(added)


def window_state(path):
    try:
        lines = path.read_text(encoding='utf-8').splitlines()
        magic, w, h, xid = lines[0].split()
        w, h, xid = int(w), int(h), int(xid)
        if magic == 'wiz3d-full-sbs-v1' and w > 0 and w % 2 == 0 and h > 0 and 0 <= xid <= 0xffffffff and len(lines) == 2:
            return w, h, lines[1].casefold(), xid
    except (OSError, ValueError, IndexError, UnicodeError):
        pass
    return None


class Declaration:
    def __init__(self):
        from Xlib import display
        self.x = display.Display()
        self.xlib = ctypes.CDLL('libX11.so.6')
        self.xlib.XOpenDisplay.argtypes = [ctypes.c_char_p]
        self.xlib.XOpenDisplay.restype = ctypes.c_void_p
        self.xlib.XCloseDisplay.argtypes = [ctypes.c_void_p]
        self.xlib.XSync.argtypes = [ctypes.c_void_p, ctypes.c_int]
        # A client can disappear between discovery and the declaration request.
        self.error = 0
        handler_type = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_void_p, ctypes.c_void_p)
        def on_error(display, event):
            self.error = 1
            return 0
        self.handler = handler_type(on_error)
        self.xlib.XSetErrorHandler.argtypes = [ctypes.c_void_p]
        self.xlib.XSetErrorHandler.restype = ctypes.c_void_p
        self.previous_handler = self.xlib.XSetErrorHandler(ctypes.cast(self.handler, ctypes.c_void_p))
        self.native = self.xlib.XOpenDisplay(None)
        if not self.native:
            raise RuntimeError('Cannot open X11 display')
        self.lib = ctypes.CDLL('libstereo-declare.so.1')
        self.lib.stereo_supported_x11.argtypes = [ctypes.c_void_p]
        self.lib.stereo_declare_x11.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_int, ctypes.c_int, ctypes.c_uint]
        self.lib.stereo_remove_x11.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
        self.version = self.lib.stereo_supported_x11(self.native)
        if self.version < 2:
            self.close()
            raise RuntimeError('KWin stereo declaration support version 2 is required')
        self.pid_atom = self.x.intern_atom('_NET_WM_PID')
        self.active = set()
        self.declared_any = False

    def candidates(self, state, pids, steam_class):
        from Xlib import X, Xatom, error
        if state is None:
            return set()
        width, height, exe, xid = state
        result = set()
        stack = [self.x.create_resource_object('window', xid)] if xid else [self.x.screen().root]
        while stack:
            window = stack.pop()
            try:
                if not xid:
                    stack.extend(window.query_tree().children)
                geom = window.get_geometry()
                if (not xid and (geom.width, geom.height) != (width, height)) or window.get_attributes().map_state != X.IsViewable:
                    continue
                classes = {s.casefold() for s in (window.get_wm_class() or ())}
                pid = window.get_full_property(self.pid_atom, Xatom.CARDINAL)
                child = pid is not None and pid.format == 32 and len(pid.value) == 1 and int(pid.value[0]) in pids
                steam = bool(steam_class and steam_class.casefold() in classes)
                identity = window.id == xid if xid else (child or steam)
                if identity and (exe in classes or steam):
                    result.add(window.id)
            except error.XError:
                continue
        # Without a native XID, ambiguous same-game windows stay undeclared.
        return result if len(result) == 1 else set()

    def update(self, wanted):
        for wid in self.active - wanted:
            self.lib.stereo_remove_x11(self.native, wid)
        self.xlib.XSync(self.native, 0)
        self.active.intersection_update(wanted)
        for wid in wanted - self.active:
            self.error = 0
            result = self.lib.stereo_declare_x11(self.native, wid, 3, 3, 3)
            self.xlib.XSync(self.native, 0)
            if result == 0 and not self.error:
                self.active.add(wid)
                self.declared_any = True
                print(f'wiz3d-run: declared 0x{wid:x}: full SBS, game/gl', flush=True)
        self.xlib.XSync(self.native, 0)

    def close(self):
        if hasattr(self, 'active'):
            self.update(set())
        self.xlib.XCloseDisplay(self.native)
        self.xlib.XSetErrorHandler(self.previous_handler)
        self.x.close()


def main():
    parser = argparse.ArgumentParser(description=__doc__, epilog="Render resolution per eye is the game’s video resolution. Set it in the game; KWin scales each complete eye to the window or screen.")
    enable = parser.add_mutually_exclusive_group()
    enable.add_argument('--enable-3d', dest='enabled', action='store_true', default=True, help='Enable 3D (default)')
    enable.add_argument('--disable-3d', dest='enabled', action='store_false', help='Disable 3D for this launch')
    parser.add_argument('--display-settings', action='store_true', help='Open Display settings')
    parser.add_argument('--steam-app-id', type=int, default=os.environ.get('SteamAppId'), help='Match steam_app_ID if Proton reparents the game')
    parser.add_argument('command', nargs=argparse.REMAINDER)
    args = parser.parse_args()
    if args.display_settings:
        return subprocess.call(['kcmshell6', 'kcm_kscreen'])
    command = args.command
    if command[:1] == ['--']:
        command = command[1:]
    if not command:
        parser.error('a game command is required after --')
    declaration = Declaration() if args.enabled else None
    env = os.environ.copy()
    env['WIZ3D_ENABLE_3D'] = '1' if args.enabled else '0'
    if declaration and declaration.version >= 3:
        env['WIZ3D_KWIN_DOUBLES'] = '1'
    overrides = env.get('WINEDLLOVERRIDES', '')
    env['WINEDLLOVERRIDES'] = overrides + (';' if overrides else '') + 'd3d9=n,b'
    with tempfile.TemporaryDirectory(prefix='wiz3d-', dir=env.get('XDG_RUNTIME_DIR')) as temp:
        state = Path(temp) / 'window-state'
        env['WIZ3D_STEREO_STATE'] = 'Z:' + str(state).replace('/', '\\')
        child = subprocess.Popen(command, env=env)
        def forward(sig, frame):
            if child.poll() is None:
                child.send_signal(sig)
        signal.signal(signal.SIGTERM, forward)
        signal.signal(signal.SIGINT, forward)
        known = {child.pid}
        last_state = None
        steam_class = f'steam_app_{args.steam_app_id}' if args.steam_app_id else None
        try:
            while child.poll() is None:
                if declaration:
                    current = window_state(state)
                    pids = descendants(child.pid, known) if current and not current[3] else known
                    if current and current != last_state:
                        print(f"wiz3d-run: Render resolution per eye: {current[0] // 2}×{current[1]}", flush=True)
                        last_state = current
                    wanted = declaration.candidates(current, pids, steam_class)
                    if os.environ.get("WIZ3D_DEBUG") and current:
                        print(f"wiz3d-run: state={current} pids={sorted(pids)} windows={wanted}", flush=True)
                    declaration.update(wanted)
                time.sleep(.1)
        finally:
            if declaration:
                declaration.close()
        if declaration and not declaration.declared_any:
            print('wiz3d-run: no full-SBS game window was declared; check the DLLs, config, and Wine Z: mapping', file=sys.stderr)
            if child.returncode == 0:
                return 1
        return child.returncode if child.returncode >= 0 else 128 - child.returncode


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, RuntimeError) as exc:
        sys.exit(f'wiz3d-run: {exc}')
